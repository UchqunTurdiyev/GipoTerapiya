# ===== SAYT =====
# Saytning to'liq manzili (Telegramdagi link shu domen bilan yasaladi). Oxirida "/" qo'ymang.
NEXT_PUBLIC_SITE_URL=https://gipnoterapiya.uz

# ===== META PIXEL + CAPI =====
NEXT_PUBLIC_META_PIXEL_ID=123456789012345
# Events Manager -> Settings -> Conversions API -> Generate access token
META_CAPI_ACCESS_TOKEN=EAAG...
# Test qilishda Events Manager -> Test events dagi kod (ishga tushgach o'chiring)
META_TEST_EVENT_CODE=
# Purchase qiymati qaysi valyutada yuboriladi: USD yoki UZS
META_CURRENCY=USD
# META_CURRENCY=USD bo'lsa: 1 USD necha so'm (kiritilgan so'm summasi shu kursda dollarga aylanadi)
USD_RATE=12600

# ===== TELEGRAM BOT =====
# @BotFather dan olingan token
TELEGRAM_BOT_TOKEN=1234567890:AA...
# Arizalar tushadigan chat/guruh/kanal ID (guruh bo'lsa -100... bilan boshlanadi)
TELEGRAM_CHAT_ID=-1001234567890

# ===== XAVFSIZLIK =====
# Mijoz ma'lumotlarini linkda shifrlash uchun maxfiy kalit (kamida 32 belgi, tasodifiy)
# Yaratish: openssl rand -hex 32
LINK_SECRET=change_me_to_a_long_random_string_0123456789abcdef
# (ixtiyoriy) Purchase sahifasida summa yuborishda so'raladigan PIN. Bo'sh qolsa PIN so'ralmaydi.
ADMIN_PIN=
